{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/admin",
      "dest": "/admin.html"
    },
    {
      "src": "/shop",
      "dest": "/productss.html"
    },
    {
      "src": "/checkout",
      "dest": "/checkout.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
